# AIMurahV3 sample env file for Docker / systemd deployments.
# Copy to `.env` (never commit it) and adjust values.

# Network bind. Keep 127.0.0.1 + reverse-proxy (nginx/caddy) for TLS, or
# switch to 0.0.0.0 inside a container that is only reachable via compose.
AIMURAH_PROXY_HOST=127.0.0.1
AIMURAH_PROXY_PORT=7830
AIMURAH_DASHBOARD_HOST=127.0.0.1
AIMURAH_DASHBOARD_PORT=7831

# Secrets. Leave empty to let the app generate on first boot and persist
# them inside config.json. Set explicitly when you want them injected
# from a secret manager instead.
AIMURAH_API_KEY=
AIMURAH_SESSION_SECRET=

# Set to 1 when serving the dashboard behind HTTPS so cookies get the
# Secure flag. Keep 0 for plain-http setups during initial bring-up.
AIMURAH_COOKIE_SECURE=0

# Optional egress proxy for the Kiro upstream (http://user:pass@host:port).
AIMURAH_UPSTREAM_PROXY=

# Log verbosity: DEBUG / INFO / WARNING / ERROR.
AIMURAH_LOG_LEVEL=INFO

# Size-based log rotation.
AIMURAH_LOG_MAX_BYTES=5000000
AIMURAH_LOG_BACKUP_COUNT=3
AIMURAH_REQUEST_LOG_MAX_BYTES=10000000

# Data directory for SQLite/config/log/pid. Use an absolute path. On a VPS
# a good default is /var/lib/aimurahv3 so systemd can chown it to the
# service user.
AIMURAH_HOME=/var/lib/aimurahv3
